#!/usr/bin/env bash
# incompetech — operate CLI for incompetech.lab980.com (incompetech catalog).
#
# A proxied app site: nginx fronts a pm2-managed Node process on
# 127.0.0.1:8072. Bring-up is `provision-site` (see lab980's CLAUDE.md);
# this script owns everything after that:
#
#   incompetech deploy    git pull -> npm ci -> build -> pm2 restart -> health probe
#   incompetech restart   pm2 restart + probe, no code change
#   incompetech logs      tail the pm2 logs for this app
#   incompetech status    HEAD, pm2 state, local + public probe, cert days
#
# Env overrides:
#   INCOMPETECH_FQDN     default incompetech.lab980.com
#   INCOMPETECH_BRANCH   default main
#   INCOMPETECH_PORT     default 8072
#
# The app dir is wherever this script's checkout lives (normally
# /var/www/incompetech) — derived from the script's own path, so the
# /usr/local/bin symlink resolves back here.
set -euo pipefail

SELF="$(readlink -f "$0")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
FQDN="${INCOMPETECH_FQDN:-incompetech.lab980.com}"
BRANCH="${INCOMPETECH_BRANCH:-main}"
PORT="${INCOMPETECH_PORT:-8072}"
APP="incompetech"

c_blue=$'\033[1;34m'; c_yellow=$'\033[1;33m'; c_red=$'\033[1;31m'; c_off=$'\033[0m'
log()  { printf '%s==>%s %s\n' "$c_blue" "$c_off" "$*"; }
warn() { printf '%swarn:%s %s\n' "$c_yellow" "$c_off" "$*" >&2; }
die()  { printf '%serror:%s %s\n' "$c_red" "$c_off" "$*" >&2; exit 1; }

usage() {
  cat <<'USAGE'
incompetech — operate incompetech.lab980.com (pm2 app behind nginx).

Usage:
  incompetech deploy [--no-build]   pull, install, build, restart, probe
  incompetech restart               pm2 restart + probe
  incompetech logs [-n N]           tail pm2 logs
  incompetech status                HEAD + pm2 + local/public probe + cert

Env: INCOMPETECH_FQDN, INCOMPETECH_BRANCH (default main), INCOMPETECH_PORT (default 8072).
USAGE
}

probe() {
  # Local first, then public: a healthy app behind a broken vhost and a dead
  # app behind a fine vhost look identical from the outside, and telling them
  # apart is most of the diagnosis.
  local lcode pcode
  lcode="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "http://127.0.0.1:$PORT/" || true)"
  pcode="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "https://$FQDN/" || true)"
  printf 'local:     http://127.0.0.1:%s/  ->  HTTP %s\n' "$PORT" "${lcode:-unreachable}"
  printf 'public:    https://%s/  ->  HTTP %s\n' "$FQDN" "${pcode:-unreachable}"
}

cmd_deploy() {
  local DO_BUILD=1
  [ "${1:-}" = "--no-build" ] && DO_BUILD=0
  cd "$ROOT"
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "$ROOT is not a git clone."
  local before after
  before="$(git rev-parse --short HEAD)"
  log "Syncing $ROOT to origin/$BRANCH"
  git fetch --quiet origin "$BRANCH"
  git reset --hard --quiet "origin/$BRANCH"
  after="$(git rev-parse --short HEAD)"
  if [ "$before" = "$after" ]; then log "already current ($after)"
  else log "$before -> $after"; git --no-pager log --oneline "$before..$after"; fi

  # npm ci, not npm install: the lockfile is the deployed dependency set, and
  # a deploy that silently resolves different versions than CI tested is the
  # bug you find at 2am.
  if [ -f package-lock.json ]; then log "npm ci"; npm ci
  elif [ -f package.json ]; then warn "no package-lock.json — falling back to npm install"; npm install; fi

  if [ "$DO_BUILD" -eq 1 ] && [ -f package.json ] && npm run 2>/dev/null | grep -qE '^  build'; then
    log "npm run build"; npm run build
  fi

  log "pm2 restart $APP"
  pm2 restart "$APP" --update-env
  pm2 save
  sleep 2
  probe
}

cmd_restart() { log "pm2 restart $APP"; pm2 restart "$APP" --update-env; sleep 2; probe; }
cmd_logs()    { pm2 logs "$APP" "$@"; }

cmd_status() {
  cd "$ROOT"
  printf 'checkout:  %s  %s\n' "$(git rev-parse --short HEAD)" "$(git log -1 --format=%s)"
  printf 'pm2:       '
  pm2 jlist 2>/dev/null \
    | python3 -c "import json,sys
try: procs=json.load(sys.stdin)
except Exception: procs=[]
p=[x for x in procs if x.get('name')=='$APP']
if not p: print('not registered'); raise SystemExit
e=p[0].get('pm2_env',{})
print('%s  mode=%s  restarts=%s  uptime-since=%s' % (
  e.get('status'), e.get('exec_mode'), e.get('restart_time'), e.get('pm_uptime')))" 2>/dev/null \
    || printf 'unknown (pm2 not readable)\n'
  probe
  local pem="/etc/letsencrypt/live/$FQDN/cert.pem"
  if [ -r "$pem" ]; then
    local end days
    end="$(openssl x509 -enddate -noout -in "$pem" | cut -d= -f2)"
    days=$(( ($(date -d "$end" +%s) - $(date +%s)) / 86400 ))
    printf 'cert:      %s days remaining (expires %s)\n' "$days" "$end"
  else
    printf 'cert:      (run as root to read expiry)\n'
  fi
}

case "${1:-}" in
  deploy)  shift; cmd_deploy "$@";;
  restart) shift; cmd_restart "$@";;
  logs)    shift; cmd_logs "$@";;
  status)  shift; cmd_status "$@";;
  -h|--help|help|"") usage;;
  *) die "unknown command: $1 (see --help)";;
esac
